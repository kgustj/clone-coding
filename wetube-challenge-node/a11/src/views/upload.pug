extends base

block content
    if errorMessage
        span=errorMessage
    form(method="POST", action="/upload")
        input(placeholder="Title", required, type="text", name="title", minLength=1, maxLength=20)
        input(placeholder="Summary", required, type="text", name="summary", minLength=20, maxLength=150) 
        input(placeholder="Genres, separated by comma.", required, type="text", name="genres")
        input(type="submit", value="Upload Movie")