# 필수
MONGO_URL=mongodb://127.0.0.1:27017/wetube
COOKIE_SECRET=change-me

# 선택: GitHub 로그인 (https://github.com/settings/developers 에서 OAuth App 생성, callback: http://localhost:4000/users/github/callback)
GITHUB_CLIENT=
GITHUB_SECRET=

# 선택: 프로필 사진을 S3에 저장할 때. 비워 두면 uploads/avatars 폴더에 저장
AWS_ID=
AWS_SECRET=
AWS_REGION=ap-northeast-2
AWS_BUCKET=
