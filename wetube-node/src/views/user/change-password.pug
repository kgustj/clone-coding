extends ../base

block content
    if errorMessage
        p
            mark=errorMessage
    form(method="POST")
        input(placeholder="Current Password", name="oldPassword", type="password", required)
        input(placeholder="New Password", name="newPassword", type="password", required)
        input(placeholder="Confirm New Password", name="newPasswordConfirm", type="password", required)
        input(type="submit", value="Change Password")
