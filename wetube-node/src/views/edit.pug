extends base

block content
    form(method="POST")
        input(placeholder="Title", required, type="text", name="title", maxLength=20, value=video.title)
        input(placeholder="Description (20~200 characters)", required, type="text", name="description", minLength=20, maxLength=200, value=video.description)
        input(placeholder="Hashtags, separated by comma", required, type="text", name="hashtags", value=video.hashtags.join(","))
        input(type="submit", value="Save")
