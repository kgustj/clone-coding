doctype html
html(lang="ko")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet", href="https://unpkg.com/mvp.css@1.17.2/mvp.css")
        title #{pageTitle} | #{siteName}
    body
        header
            nav
                a(href="/")
                    b=siteName
                ul
                    li
                        a(href="/") Home
                    li
                        a(href="/search") Search
                    if loggedIn
                        li
                            a(href="/videos/upload") Upload Video
                        li
                            a(href=`/users/${loggedInUser._id}`) My Profile
                        li
                            a(href="/users/edit") Edit Profile
                        li
                            a(href="/users/logout") Logout
                    else
                        li
                            a(href="/join") Join
                        li
                            a(href="/login") Login
            h1=pageTitle
        main
            block content
        footer
            small &copy; #{new Date().getFullYear()} #{siteName}
        block scripts
